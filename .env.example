# Required: enable Maps JavaScript API for this browser-visible key.
# Restrict it to your deployment's HTTP referrers in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_browser_api_key

# Optional. DEMO_MAP_ID is used automatically for local development.
GOOGLE_MAPS_MAP_ID=your_map_id

# Optional compatible crash-data backend.
CRASH_API_URL=https://denver.zerovision.dev/map/api
